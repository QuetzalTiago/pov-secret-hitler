# Copy to .env and fill in. .env is git-ignored and only read by the server.
# Jev (TypeSafe AI) decision model for smarter bots. Leave empty to use the built-in strategy.
TYPESAFE_API_KEY=
# Optional overrides
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=3000
# JEV_MAX_INFLIGHT=6
