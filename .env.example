# Copy to .env and fill in. .env is git-ignored and only read by the server.

# --- Bot decisions: Jev (TypeSafe AI). Leave empty to use the built-in strategy. ---
TYPESAFE_API_KEY=
# Optional overrides
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=3000
# JEV_MAX_INFLIGHT=6

# --- Bot table talk: a small, fast text model that writes what the bots type in the chat. ---
# Without a key the bots still play and still talk, but only with the built-in template lines.
# Jev keeps deciding WHAT a bot says (truth, lie, accusation); this only writes the words.
SH_LLM_KEY=

# Provider: gemini (default) | openai | anthropic.
# "openai" also covers any OpenAI-compatible endpoint via SH_LLM_URL: Groq, OpenRouter, Ollama, LM Studio.
# SH_LLM_PROVIDER=gemini

# Model. Defaults per provider, all picked for speed because chat is realtime:
#   gemini    -> gemini-3.5-flash-lite   (free tier: aistudio.google.com/apikey)
#   openai    -> gpt-5-mini
#   anthropic -> claude-haiku-4-5
# SH_LLM_MODEL=

# Free and fast alternatives, as examples:
#   Groq:       SH_LLM_PROVIDER=openai  SH_LLM_URL=https://api.groq.com/openai/v1  SH_LLM_MODEL=llama-3.3-70b-versatile
#   Ollama:     SH_LLM_PROVIDER=openai  SH_LLM_URL=http://127.0.0.1:11434/v1       SH_LLM_MODEL=llama3.1  SH_LLM_KEY=ollama
#   OpenRouter: SH_LLM_PROVIDER=openai  SH_LLM_URL=https://openrouter.ai/api/v1    SH_LLM_MODEL=<a :free model>
# SH_LLM_URL=

# Language the bots speak: es-AR (Rioplatense, default) or en.
# Also decides which set of bot names the host gets when adding bots.
# SH_BOT_LANG=es-AR

# Bots swear like real players. Set to 0 for a table you can show your mother.
# SH_LLM_PROFANITY=1

# Safety valves
# SH_LLM_TIMEOUT_MS=6000     # a slow answer is dropped; the bot types its template line instead
# SH_LLM_MAX_INFLIGHT=4      # concurrent requests across all rooms
# SH_LLM_MAX_CALLS=400       # generated lines per game, so a long table cannot run up a bill
